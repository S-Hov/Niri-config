// Имена и режимы: `niri msg outputs` / Names and modes: `niri msg outputs`

// Внешний монитор 34" слева / External 34" monitor on the left (120Hz = perfect 2:1 ratio with 240Hz)
output "DP-1" {
    mode "3440x1440@120.000"
    scale 1.5
    transform "normal"
    position x=0 y=0
}

// Экран ноутбука справа / Laptop screen on the right
output "eDP-1" {
    mode "2560x1600@240.000"
    scale 1.5
    transform "normal"
    position x=2293 y=0
    focus-at-startup
}

// Если новый монитор подключён по HDMI, замените DP-2 на HDMI-A-1.
// If connected over HDMI, replace DP-2 with HDMI-A-1.

// Популярные альтернативы / Popular alternatives
